<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FastFoodShop1</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <!-- Thanh trên cùng -->
    <div class="topbar">
        <div class="container d-flex justify-content-between align-items-center py-1">
            <span class="phone">📞 0123 456 789</span>
            <partial name="_LoginPartial" />
        </div>
    </div>

    <!-- Logo, tìm kiếm -->
    <div class="header-main">
        <div class="container">
            <div class="row align-items-center g-3">
                <div class="col-md-3 text-center text-md-start">
                    <a class="logo" asp-area="" asp-controller="Home" asp-action="Index">🍔 FastFood</a>
                </div>
                <div class="col-md-9">
                    <form asp-controller="Menu" asp-action="Index" method="get" class="d-flex search-box">
                        <select name="price" class="form-select" style="max-width:170px">
                            <option value="">Chọn khoảng giá</option>
                            <option value="0-30000">Dưới 30.000đ</option>
                            <option value="30000-60000">30.000 - 60.000đ</option>
                            <option value="60000-100000">60.000 - 100.000đ</option>
                            <option value="100000-99999999">Trên 100.000đ</option>
                        </select>
                        <input name="search" class="form-control" placeholder="Tìm món ăn..." />
                        <button type="submit">🔍</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Thanh menu cam -->
    <nav class="main-nav">
        <div class="container d-flex flex-wrap align-items-center">
            <span class="cat-title">☰ Danh mục</span>
            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">Trang chủ</a>
            <a class="nav-link" asp-area="" asp-controller="Menu" asp-action="Index">Thực đơn</a>
            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Privacy">Giới thiệu</a>

            <div class="nav-actions ms-auto">
                @if (User.Identity?.Name == "admin@gmail.com")
                {
                    <a asp-area="" asp-controller="ProductAdmin" asp-action="Index">Quản lý món</a>
                    <a asp-area="" asp-controller="Sale" asp-action="Index">Quản lý sale</a>
                }
                <a asp-area="" asp-controller="Cart" asp-action="Index">🛒 Giỏ hàng (@Context.Session.GetCart().Sum(c => c.Quantity))</a>
            </div>
        </div>
    </nav>

    <div class="container mt-3">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="site-footer">
        <div class="container row mx-auto">
            <div class="col-md-4 mb-3">
                <h6>FastFood</h6>
                <p>Đồ ăn nhanh nóng giòn, giao tận nơi.</p>
            </div>
            <div class="col-md-4 mb-3">
                <h6>Liên hệ</h6>
                <p>📞 0123 456 789<br />✉ lienhe@fastfood.vn</p>
            </div>
            <div class="col-md-4 mb-3">
                <h6>Giờ mở cửa</h6>
                <p>8:00 - 22:00 mỗi ngày</p>
            </div>
        </div>
        <div class="text-center small">&copy; 2026 FastFood - Đồ án phát triển ứng dụng web</div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>