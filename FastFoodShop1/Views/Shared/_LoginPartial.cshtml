@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

<div class="user-box">
    @if (SignInManager.IsSignedIn(User))
    {
        var name = UserManager.GetUserName(User) ?? "";
        <a class="user-chip" asp-area="Identity" asp-page="/Account/Manage/Index" title="Quản lý tài khoản">
            <span class="avatar">@(name.Length > 0 ? name.Substring(0, 1).ToUpper() : "?")</span>
            <span>Xin chào, <b>@name</b></span>
        </a>
        <form id="logoutForm" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })" method="post">
            <button id="logout" type="submit" class="btn-logout">Đăng xuất</button>
        </form>
    }
    else
    {
        <a class="btn-auth" id="register" asp-area="Identity" asp-page="/Account/Register">Đăng ký</a>
        <a class="btn-auth btn-auth-fill" id="login" asp-area="Identity" asp-page="/Account/Login">Đăng nhập</a>
    }
</div>