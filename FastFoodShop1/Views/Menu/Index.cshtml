@model List<FastFoodShop1.Models.Product>

@{
    string Icon(string name) => name switch
    {
        "Burger" => "🍔",
        "Gà rán" => "🍗",
        "Khoai tây" => "🍟",
        "Đồ uống" => "🥤",
        "Mì" => "🍜",
        "Cơm" => "🍚",
        "Tráng miệng" => "🍰",
        _ => "🍽️"
    };
    ViewData["Title"] = "Thực đơn";
    var categories = (List<FastFoodShop1.Models.Category>)ViewBag.Categories;
    int? currentCat = ViewBag.CategoryId as int?;
}

<h3 class="section-title">Thực đơn</h3>

<form method="get" class="row g-2 mb-3">
    <div class="col-md-4">
        <input name="search" value="@ViewBag.Search" class="form-control" placeholder="Tìm món..." />
    </div>
    <div class="col-md-3">
        <select name="categoryId" class="form-select">
            <option value="">Tất cả danh mục</option>
            @foreach (var c in categories)
            {
                <option value="@c.Id" selected="@(currentCat == c.Id)">@c.Name</option>
            }
        </select>
    </div>
    <div class="col-auto">
        <button class="btn btn-brand">Lọc</button>
    </div>
</form>

<div class="mb-4 d-flex flex-wrap gap-2">
    <a class="btn btn-sm @(currentCat == null ? "btn-brand" : "btn-outline-secondary")" asp-action="Index">Tất cả</a>
    @foreach (var c in categories)
    {
        <a class="btn btn-sm @(currentCat == c.Id ? "btn-brand" : "btn-outline-secondary")"
           asp-action="Index" asp-route-categoryId="@c.Id">@Icon(c.Name) @c.Name</a>
    }
</div>

<div class="row g-3">
    @foreach (var p in Model)
    {
        <div class="col-6 col-md-3">
            <div class="product-card">
                @if (p.IsOnSale)
                {
                    <span class="sale-badge">-@p.DiscountPercent%</span>
                }
                <div class="thumb">
                    @if (!string.IsNullOrEmpty(p.ImageUrl))
                    {
                        <img src="@p.ImageUrl" alt="@p.Name" />
                    }
                    else
                    {
                        @Icon(p.Category?.Name ?? "")
                    }
                </div>
                <div class="p-3">
                    <div class="name">@p.Name</div>
                    <p class="text-muted small mb-1">@p.Description</p>
                    @if (p.IsOnSale)
                    {
                        <div class="price">@p.SalePrice!.Value.ToString("N0") đ</div>
                        <div class="text-muted text-decoration-line-through small mb-2">@p.Price.ToString("N0") đ</div>
                    }
                    else
                    {
                        <div class="price mb-2">@p.Price.ToString("N0") đ</div>
                    }
                    <form method="post" asp-controller="Cart" asp-action="Add"><input type="hidden" name="id" value="@p.Id" /><button class="btn btn-brand btn-sm w-100">Thêm vào giỏ</button></form>
                </div>
            </div>
        </div>
    }
    @if (!Model.Any())
    {
        <p>Không tìm thấy món nào.</p>
    }
</div>