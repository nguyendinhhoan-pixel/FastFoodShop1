@model List<FastFoodShop1.Models.CartItem>
@{
    ViewData["Title"] = "Giỏ hàng";
}

<h3 class="section-title">🛒 Giỏ hàng</h3>

@if (!Model.Any())
{
    <div class="alert alert-light border">Giỏ hàng đang trống.</div>
    <a class="btn btn-brand" asp-controller="Menu" asp-action="Index">Xem thực đơn</a>
}
else
{
    <table class="table align-middle">
        <thead>
            <tr><th>Món</th><th>Đơn giá</th><th style="width:150px">Số lượng</th><th>Thành tiền</th><th></th></tr>
        </thead>
        <tbody>
            @foreach (var i in Model)
            {
                <tr>
                    <td>@i.Name</td>
                    <td>@i.Price.ToString("N0") đ</td>
                    <td>
                        <form method="post" asp-action="Update" class="d-flex gap-1">
                            <input type="hidden" name="id" value="@i.ProductId" />
                            <input type="number" name="quantity" value="@i.Quantity" min="0" class="form-control form-control-sm" />
                            <button class="btn btn-outline-secondary btn-sm">Cập nhật</button>
                        </form>
                    </td>
                    <td class="fw-bold">@i.Total.ToString("N0") đ</td>
                    <td>
                        <form method="post" asp-action="Remove">
                            <input type="hidden" name="id" value="@i.ProductId" />
                            <button class="btn btn-outline-danger btn-sm">Xóa</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <div class="d-flex justify-content-between align-items-center">
        <form method="post" asp-action="Clear">
            <button class="btn btn-outline-secondary">Xóa hết</button>
        </form>
        <div class="text-end">
            <div class="fs-4 fw-bold price">Tổng: @Model.Sum(i => i.Total).ToString("N0") đ</div>
            <button class="btn btn-brand mt-2" disabled>Thanh toán (làm ở bước sau)</button>
        </div>
    </div>
}