@model List<FastFoodShop1.Models.Product>
@{ ViewData["Title"] = "Quản lý món"; }

<div class="d-flex justify-content-between mb-3">
    <h2>Quản lý món ăn</h2>
    <a class="btn btn-danger" asp-action="Create">+ Thêm món</a>
</div>

<table class="table align-middle">
    <thead>
        <tr><th>Ảnh</th><th>Tên</th><th>Danh mục</th><th>Giá</th><th></th></tr>
    </thead>
    <tbody>
    @foreach (var p in Model)
    {
        <tr>
            <td>
                @if (!string.IsNullOrEmpty(p.ImageUrl))
                {
                    <img src="@p.ImageUrl" style="width:70px;height:70px;object-fit:cover" class="rounded" />
                }
                else { <span class="fs-3">🍽️</span> }
            </td>
            <td>@p.Name</td>
            <td>@p.Category?.Name</td>
            <td>@p.Price.ToString("N0") đ</td>
            <td class="text-end">
                <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@p.Id">Sửa / đổi ảnh</a>
                <form method="post" asp-action="Delete" asp-route-id="@p.Id" class="d-inline"
                      onsubmit="return confirm('Xóa món này?');">
                    <button class="btn btn-sm btn-outline-danger">Xóa</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>